# Kopie als .env speichern (nur lokal, wird nicht hochgeladen).
# Auf Railway trägst du die gleichen Werte unter «Variables» ein.

# Stripe → Entwickler → API-Schlüssel. Zum Testen sk_test_…, live sk_live_…
STRIPE_SECRET_KEY=sk_test_xxx

# Eigene Domain, sobald eingerichtet (ohne / am Ende). Leer = Railway-Domain
PUBLIC_URL=

# Passwort für /admin (Newsletter-Liste und Kontaktanfragen). Leer = /admin ist aus
ADMIN_PASSWORD=

# PostgreSQL. Auf Railway: Referenz ${{Postgres.DATABASE_URL}}. Lokal leer = Speicherung in data/
DATABASE_URL=

# Optional: E-Mail bei neuer Kontaktanfrage über resend.com
RESEND_API_KEY=
MAIL_FROM=Filamour Shop <shop@filamour.ch>
NOTIFY_EMAIL=hallo@filamour.ch
